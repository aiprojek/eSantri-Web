{
  "entities": {
    "Santri": {
      "title": "Santri",
      "description": "Data santri pondok pesantren",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "namaLengkap": { "type": "string" },
        "nis": { "type": "string" },
        "kamarId": { "type": "number" },
        "lastModified": { "type": "number" }
      },
      "required": ["id", "namaLengkap", "nis"]
    },
    "User": {
      "title": "User",
      "description": "Data pengguna aplikasi",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "username": { "type": "string" },
        "role": { "type": "string" },
        "lastModified": { "type": "number" }
      },
      "required": ["id", "username", "role"]
    },
    "Pendaftar": {
      "title": "Pendaftar",
      "description": "Data pendaftaran santri baru",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "namaLengkap": { "type": "string" },
        "tanggalDaftar": { "type": "string" },
        "status": { "type": "string" },
        "customData": { "type": "string" },
        "lastModified": { "type": "number" }
      },
      "required": ["id", "namaLengkap", "status"]
    },
    "DigitalAsset": {
      "title": "DigitalAsset",
      "description": "Berkas & Aset Digital (foto santri, dokumen, sertifikat, berkas)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "number" },
        "category": { "type": "string" },
        "relatedId": { "type": "string" },
        "syncStatus": { "type": "string" },
        "lastModified": { "type": "number" }
      },
      "required": ["id", "fileName", "fileType", "category", "lastModified"]
    },
    "TahfizhRecord": {
      "title": "TahfizhRecord",
      "description": "Catatan setoran ziyadah, murojaah, ujian hafalan, dan evaluasi tahfizh santri",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "santriId": { "type": "number" },
        "tanggal": { "type": "string" },
        "tipe": { "type": "string" },
        "juz": { "type": "number" },
        "surahAwal": { "type": "string" },
        "ayatAwal": { "type": "number" },
        "surahAkhir": { "type": "string" },
        "ayatAkhir": { "type": "number" },
        "nilai": { "type": "number" },
        "kelancaran": { "type": "number" },
        "tajwid": { "type": "number" },
        "makhraj": { "type": "number" },
        "adab": { "type": "number" },
        "jumlahTeguran": { "type": "number" },
        "jumlahKesalahan": { "type": "number" },
        "muhaffizhId": { "type": "number" },
        "halaqahId": { "type": "string" },
        "catatan": { "type": "string" },
        "statusMutqin": { "type": "boolean" },
        "lastModified": { "type": "number" }
      },
      "required": ["id", "santriId", "tanggal", "tipe", "lastModified"]
    },
    "AbsensiRecord": {
      "title": "AbsensiRecord",
      "description": "Catatan presensi harian santri dan dispensasi per sesi kegiatan",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "santriId": { "type": "number" },
        "rombelId": { "type": "number" },
        "tanggal": { "type": "string" },
        "status": { "type": "string", "enum": ["H", "S", "I", "A"] },
        "keterangan": { "type": "string" },
        "sesi": { "type": "string" },
        "recordedBy": { "type": "string" },
        "lastModified": { "type": "number" }
      },
      "required": ["id", "santriId", "rombelId", "tanggal", "status", "lastModified"]
    },
    "JurnalMengajarRecord": {
      "title": "JurnalMengajarRecord",
      "description": "Catatan jurnal mengajar ustadz dan kegiatan KBM",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "tanggal": { "type": "string" },
        "rombelId": { "type": "number" },
        "guruId": { "type": "number" },
        "mataPelajaranId": { "type": "number" },
        "tipeEntri": { "type": "string" },
        "materi": { "type": "string" },
        "catatan": { "type": "string" },
        "lastModified": { "type": "number" }
      },
      "required": ["id", "tanggal", "rombelId", "guruId", "lastModified"]
    },
    "BkSession": {
      "title": "BkSession",
      "description": "Catatan sesi bimbingan konseling santri (BK) per tenant",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "santriId": { "type": "number" },
        "tanggal": { "type": "string" },
        "kategori": { "type": "string" },
        "keluhan": { "type": "string" },
        "penanganan": { "type": "string" },
        "hasil": { "type": "string" },
        "status": { "type": "string" },
        "privasi": { "type": "string" },
        "konselor": { "type": "string" },
        "tanggalBerikutnya": { "type": "string" },
        "pihakTerlibat": { "type": "array", "items": { "type": "string" } },
        "komitmenSantri": { "type": "string" },
        "followUpLogs": { "type": "array" },
        "deleted": { "type": "boolean" },
        "lastModified": { "type": "number" }
      },
      "required": ["id", "santriId", "tanggal", "kategori", "keluhan", "penanganan", "lastModified"]
    },
    "BukuTamu": {
      "title": "BukuTamu",
      "description": "Catatan kunjungan tamu dan logistik pos keamanan satpam",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "tanggal": { "type": "string" },
        "jamMasuk": { "type": "string" },
        "jamKeluar": { "type": "string" },
        "namaTamu": { "type": "string" },
        "noHp": { "type": "string" },
        "kategori": { "type": "string" },
        "santriId": { "type": "number" },
        "bertemuDengan": { "type": "string" },
        "keperluan": { "type": "string" },
        "kendaraan": { "type": "string" },
        "platNomor": { "type": "string" },
        "status": { "type": "string" },
        "petugas": { "type": "string" },
        "nomorBadge": { "type": "string" },
        "jenisIdentitas": { "type": "string" },
        "nomorIdentitas": { "type": "string" },
        "jumlahRombongan": { "type": "number" },
        "tipeEntri": { "type": "string" },
        "statusPaket": { "type": "string" },
        "namaKurirEkspedisi": { "type": "string" },
        "noResi": { "type": "string" },
        "deskripsiPaket": { "type": "string" },
        "penerimaPaket": { "type": "string" },
        "waktuDiambil": { "type": "string" },
        "lastModified": { "type": "number" }
      },
      "required": ["id", "tanggal", "jamMasuk", "namaTamu", "status", "petugas", "lastModified"]
    }
  },
  "firestore": {
    "tenants/{tenantId}/santri": {
      "schema": "Santri",
      "description": "Koleksi data santri per tenant"
    },
    "tenants/{tenantId}/users": {
      "schema": "User",
      "description": "Koleksi data user per tenant"
    },
    "tenants/{tenantId}/pendaftar": {
      "schema": "Pendaftar",
      "description": "Koleksi data pendaftar PSB per tenant"
    },
    "tenants/{tenantId}/digitalAssets": {
      "schema": "DigitalAsset",
      "description": "Koleksi berkas & aset digital per tenant"
    },
    "tenants/{tenantId}/tahfizh": {
      "schema": "TahfizhRecord",
      "description": "Koleksi catatan tahfizh & ujian santri per tenant"
    },
    "tenants/{tenantId}/absensi": {
      "schema": "AbsensiRecord",
      "description": "Koleksi catatan presensi santri per tenant"
    },
    "tenants/{tenantId}/bkSessions": {
      "schema": "BkSession",
      "description": "Koleksi sesi bimbingan konseling santri per tenant"
    },
    "tenants/{tenantId}/jurnalMengajar": {
      "schema": "JurnalMengajarRecord",
      "description": "Koleksi jurnal mengajar ustadz per tenant"
    },
    "tenants/{tenantId}/bukuTamu": {
      "schema": "BukuTamu",
      "description": "Koleksi catatan buku tamu dan ekspedisi pos satpam per tenant"
    },
    "tenants/{tenantId}/settings": {
      "schema": "object",
      "description": "Pengaturan aplikasi per tenant"
    }
  }
}
